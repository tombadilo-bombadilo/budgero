{
  "name": "@budgero/core",
  "version": "1.0.0",
  "description": "Shared TypeScript domain logic for Budgero — database schema/migrations, SQL services, and business calculations. Runs in Node and the browser (sql.js / SQLite).",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "tombadilo-bombadilo",
  "keywords": [
    "budgero",
    "budgeting",
    "personal-finance",
    "sqlite",
    "typescript"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "browser": "./dist/browser.js",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "require": "./dist/browser.js",
      "types": "./dist/browser.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:node": "vitest run",
    "test:node:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "bench": "node bench/run.mjs",
    "bench:gen": "node bench/gen.mjs",
    "bench:profile": "node bench/profile.mjs",
    "parity": "node parity/run.mjs",
    "fuzz:snapshot": "vitest run node-tests/budget-snapshot.fuzz.node.spec.ts node-tests/budget-snapshot-monthly.fuzz.node.spec.ts",
    "fuzz:snapshot:long": "bash parity/fuzz-long.sh"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@budgero/eslint-config": "workspace:*",
    "@types/debug": "^4.1.13",
    "@types/node": "^20.19.43",
    "@types/sql.js": "^1.4.11",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "globals": "^15.15.0",
    "sql.js": "^1.14.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "files": [
    "dist"
  ]
}
